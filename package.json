{
  "name": "apidoorway",
  "version": "1.0.0",
  "description": "APIDoorway — API Marketplace & Management Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:approve": "npx tsx scripts/approve-apis.ts",
    "catalog:sync": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py",
    "catalog:sync:dry": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --dry-run",
    "catalog:hydrate": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --skip-fetch --hydrate --hydrate-limit 250",
    "catalog:seed": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --hydrate --hydrate-limit 200 && npx tsx prisma/seed.ts",
    "catalog:venv": "python3 -m venv scripts/catalog/.venv && scripts/catalog/.venv/bin/pip install -r scripts/catalog/requirements.txt",
    "setup": "bash scripts/setup-local.sh",
    "test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [
    "api",
    "marketplace",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "ioredis": "^5.9.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "stripe": "^20.2.0",
    "swagger-ui-react": "^5.34.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2",
    "source-map-js": "^1.2.2",
    "nanoid": "^3.3.20",
    "qs": "^6.17.0",
    "yaml": "^2.9.1",
    "dompurify": "^3.3.1",
    "brace-expansion": "^2.1.7",
    "lodash": "^4.18.1",
    "form-data": "^4.0.6",
    "d3-color": "^3.1.0",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.0",
    "defu": "^6.1.7",
    "postcss-selector-parser": "^7.1.7",
    "swagger-ui-react": {
      "js-yaml": "^4.3.2"
    }
  }
}
