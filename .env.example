# Database (Neon pooled connection string for serverless / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth (required)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="same-as-NEXTAUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
# On Vercel set to https://YOUR_PROJECT.vercel.app (or your custom domain)

# OAuth (optional — social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe test mode (optional — required for Pro checkout / portal)
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Redis (optional — Upstash use rediss:// … ; falls back to in-memory if down)
REDIS_URL="rediss://default:PASSWORD@YOUR_DB.upstash.io:6379"

# Optional catalog feeds (admin import / Python sync uses feeds.local.json)
CATALOG_DIRECTORY_FEED_URL=""
CATALOG_DIRECTORY_FEED_URL_2=""
CATALOG_OPENAPI_INDEX_URL=""

# Cron protection (required for /api/cron/* — fail closed if unset)
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Allow demo seed passwords in production (disposable demos only)
# ALLOW_DEMO_SEED=true

# Kong Gateway (optional)
KONG_ENABLED=false
KONG_ADMIN_URL=http://localhost:8001
KONG_API_URL=http://localhost:8000
