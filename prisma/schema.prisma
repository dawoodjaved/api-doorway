// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Ensure Vercel (Amazon Linux) gets the correct query engine binary
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  name              String?
  email             String        @unique
  emailVerified     DateTime?
  image             String?
  role              String        @default("user") // user, admin, provider
  stripeCustomerId  String?       @unique
  accounts          Account[]
  sessions          Session[]
  apis              API[]
  apiKeys           APIKey[]
  subscriptions     Subscription[]
  reviews           Review[]
  invoices          Invoice[]
  payouts           Payout[]
  tickets           Ticket[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model API {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String        @db.Text
  category      String
  logo          String?
  baseUrl       String?       // Upstream URL for gateway proxy (fallback: OpenAPI servers[0])
  // Catalog enrichment (APIDoorway sync / publisher)
  authType      String?       // none | apiKey | oauth | http | unknown
  https         Boolean?      @default(true)
  cors          String?       // yes | no | unknown
  docsUrl       String?       // External docs / homepage
  openapiUrl    String?       // Link to OpenAPI/Swagger if known
  hasOpenApi    Boolean       @default(false)
  source        String?       // internal: directory | openapi | merged | manual | seed
  sourceKey     String?       // Stable sync key (unique when set; never shown in UI)
  tags          String[]      @default([])
  arenaScore    Int           @default(0) // 0–100 developer-readiness score
  endpointCount Int           @default(0)
  tryReady      Boolean       @default(false) // real OpenAPI paths + HTTPS
  lastSyncedAt  DateTime?
  isPublic      Boolean       @default(true)
  isApproved    Boolean       @default(false)
  isFeatured    Boolean       @default(false)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  versions      APIVersion[]
  subscriptions Subscription[]
  reviews       Review[]
  analytics     AnalyticsSnapshot[]
  apiKeys       APIKey[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([arenaScore])
  @@index([hasOpenApi])
  @@index([sourceKey])
  @@index([userId])
  @@index([tryReady])
  @@index([isPublic, isApproved, arenaScore])
  @@index([isPublic, isApproved, createdAt])
  @@index([isPublic, isApproved, isFeatured])
}

model APIVersion {
  id              String     @id @default(cuid())
  apiId           String
  api             API        @relation(fields: [apiId], references: [id], onDelete: Cascade)
  version         String
  openApiSpec     Json
  isDeprecated    Boolean    @default(false)
  deprecationDate DateTime?
  changelog       String?     @db.Text
  endpoints       Endpoint[]
  createdAt       DateTime   @default(now())
  @@unique([apiId, version])
  @@index([apiId, createdAt])
}

model Endpoint {
  id          String       @id @default(cuid())
  versionId   String
  version     APIVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  method      String
  path        String
  description String?      @db.Text
  requestLogs RequestLog[]
  @@unique([versionId, method, path])
}

model APIKey {
  id          String       @id @default(cuid())
  key         String       @unique // hashed key (sha256); plaintext shown once on create
  keyPrefix   String?      // e.g. adw_xxxx for display/lookup hint
  name        String
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiId       String
  api         API          @relation(fields: [apiId], references: [id], onDelete: Cascade)
  scopes      String[]
  environment String       @default("production")
  isActive    Boolean      @default(true)
  lastUsedAt  DateTime?
  requestLogs RequestLog[]
  createdAt   DateTime     @default(now())
  expiresAt   DateTime?
  @@index([keyPrefix])
  @@index([userId])
  @@index([userId, apiId])
  @@index([apiId])
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiId              String
  api                API      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  plan               String   // free, pro, enterprise
  status             String   // active, cancelled, past_due, trialing
  stripeCustomerId   String
  stripeSubscriptionId String?
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([userId, apiId])
  @@index([stripeSubscriptionId])
  @@index([userId, status])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("usd")
  status      String   // paid, pending, failed
  paidAt      DateTime?
  dueDate     DateTime
  items       Json
  stripePdfUrl String?
  stripeInvoiceId String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Payout {
  id            String   @id @default(cuid())
  providerId   String
  provider     User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount       Float
  status       String   // pending, processing, paid, failed
  stripePayoutId String?
  paidAt       DateTime?
  period       String
  createdAt    DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiId     String
  api       API      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, apiId])
  @@index([apiId])
}

model RequestLog {
  id         String   @id @default(cuid())
  apiKeyId   String
  apiKey     APIKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  method     String
  path       String
  statusCode Int
  latency    Int      // milliseconds
  timestamp  DateTime @default(now())
  ipAddress  String
  userAgent  String?
  requestBody Json?
  responseBody Json?
  @@index([apiKeyId, timestamp])
  @@index([endpointId, timestamp])
}

model AnalyticsSnapshot {
  id            String   @id @default(cuid())
  apiId         String
  api           API      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  date          DateTime
  totalRequests Int
  successRequests Int
  errorRequests Int
  avgLatency    Float
  p95Latency    Float
  p99Latency    Float
  uniqueUsers   Int
  revenue       Float
  topEndpoints  Json
  topCountries  Json
  @@unique([apiId, date])
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String   @db.Text
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("medium") // low, medium, high, urgent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}
