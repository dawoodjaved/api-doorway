# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files / secrets
.env*.local
.env
.env*.bak
*.bak
*.backup

# vercel / neon local
.vercel
.neon

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations
/generated/prisma

# ── local-only (not for GitHub) ─────────────────────────────────────────────

# docs — public repo keeps README only
*.md
!README.md

# catalog data & sync artifacts (keep private / local)
data/catalog/*.csv
data/catalog/seed_catalog.json
data/catalog/SYNC_REPORT.md
data/catalog/specs/**
!data/catalog/specs/.gitkeep
!data/catalog/.gitkeep

# private feed URLs for catalog sync (copy from feeds.example.json)
scripts/catalog/feeds.local.json
scripts/catalog/.venv/
scripts/catalog/**/__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env*
!.env.example
